# Copy to .env and fill in:
#   cp .env.example .env && chmod 600 .env

# Base domain. Uses dashboard.<domain>, api.<domain>, broker.<domain>.
NM_DOMAIN=netmaker.example.com

# netmaker and netmaker-ui must share the same tag.
NETMAKER_VERSION=v1.5.1
MOSQUITTO_VERSION=2.0.20
CLOUDFLARED_VERSION=latest

# Zero Trust > Networks > Tunnels > (tunnel) token.
TUNNEL_TOKEN=

# Admin master key: openssl rand -hex 32
MASTER_KEY=

# Must match the entry in password.txt.
MQ_USERNAME=netmaker
MQ_PASSWORD=
